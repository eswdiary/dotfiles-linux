{
    "layer": "top",
    "position": "top",
    "height": 39,
    "margin-top": 3,
    "margin-left": 6,
    "margin-right": 6,
    "margin-bottom": 0,

    // ----------------------------------- //
    //              Module                 //
    // ----------------------------------- //
    "modules-left": [
        "clock",
        "memory",
        "backlight",
    ],

    "modules-center": [
        "niri/workspaces"
    ],
    
    "modules-right": [
        "niri/window",
        "tray",
        "pulseaudio",
        "network",
        "battery",
    ],

    // ----------------------------------- //
    //              niri                   //
    // ----------------------------------- //

    "niri/window": {
        "format": "{title} | {app_id}",
        "separate-outputs": true,
        "icon": true,
    },

    "niri/workspaces": {
        "on-click": "activate",
        "format": "{icon}",
        "all-outputs": false,
        "active-only": false,
        "format-icons": {
            "1": "I",
            "2": "II",
            "3": "III",
            "4": "IV",
            "5": "V",
            "6": "VI",
            "7": "VII",
            "8": "VIII",
            "9": "IX",
            "0": "X",
        },
    },

    // ----------------------------------- //
    //              Memory                 //
    // ----------------------------------- //

    "memory": {
        "interval": 5,
        "format": "󰍛 {}%",
        "max-length": 10,
        "on-click": "kitty --start-as=fullscreen sh -c 'btop'"
    },

    // ----------------------------------- //
    //               Tray                  //
    // ----------------------------------- //

    "tray": {
        "icon-size": 16,
        "spacing": 10
    },

    // ----------------------------------- //
    //              Clock                  //
    // ----------------------------------- //

    "clock": {
        "tooltip": false,
        "format": " {:%y%m%d %I%M %p}",
    },

    // ----------------------------------- //
    //            Pulseaudio               //
    // ----------------------------------- //

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "󰂰",
        "nospacing": 1,
        "tooltip-format": "Volume : {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "",
            "default": ["󰖀","󰕾",""]
        },
        "on-click": "qpwgraph",
        "on-click-right": "pavucontrol",
        "scroll-step": 1
    },

    // ----------------------------------- //
    //            Bakclight                //
    // ----------------------------------- //

    "backlight": {
        "tooltip": false,
	    "device": "amd_backlight",
	    "format": "{icon} {percent}%",
	    "format-icons": ["", ""]
    },

    // ----------------------------------- //
    //            Network                  //
    // ----------------------------------- //
    
    "network": {
        // "interface": "wlan0",
        "format": "{ifname}",
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "Connect 󰊗",
        "format-disconnected": "", //An empty format will hide the module.
        "tooltip-format": "{ifname} via {gwaddr} 󰊗",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
        "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50
    },

    // ----------------------------------- //
    //              Battery                //
    // ----------------------------------- //

    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": {
            "charging": [
                "󰢜",
                "󰂆",
                "󰂇",
                "󰂈",
                "󰢝",
                "󰂉",
                "󰢞",
                "󰂊",
                "󰂋",
                "󰂅"
            ],
            "default": [
                "󰁺",
                "󰁻",
                "󰁼",
                "󰁽",
                "󰁾",
                "󰁿",
                "󰂀",
                "󰂁",
                "󰂂",
                "󰁹"
            ]
        },
        "format-full": "Charged ",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": " {capacity}%",
        "interval": 5,
        "states": {
            "warning": 30,
            "critical": 10
        },
        "tooltip": false
    }
}
