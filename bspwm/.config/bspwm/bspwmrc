#! /bin/sh

pgrep -x sxhkd > /dev/null || sxhkd &


xrandr --output eDP-1-0 --auto --mode 1920x1080 --rate 144 --output HDMI-A-1-0 --primary --mode 2560x1440 --right-of eDP-1-0 --rotate normal --rate 144

# First monitor(laptop)
bspc monitor eDP-1-0 -d I II III

# Second monitor
bspc monitor HDMI-A-1-0 -d IV V VI

bspc config border_width         1
bspc config window_gap          10

bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true

bspc config focus_follows_pointer   true 

# bspc rule -a Gimp desktop='^8' state=floating follow=on
# bspc rule -a Chromium desktop='^2'
# bspc rule -a mplayer2 state=floating
# bspc rule -a Kupfer.py focus=on
# bspc rule -a Screenkey manage=off

# Autostart app
sxhkd &
picom --config $HOME/.config/picom/picom.conf &
feh --bg-scale /home/ewd/Pictures/Wallpaper/wallhaven-zywzdy.jpg &
# dunst &
$HOME/.config/polybar/launch.sh $


